# Supabase project settings (Dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# WhatsApp number that receives order notifications (with country code, no + or spaces)
# Example for Pakistan: 923001234567
VITE_WHATSAPP_NUMBER=923001234567

# Public site URL (used for canonical URLs, sitemap, structured data)
VITE_SITE_URL=https://thebaigarts.com
